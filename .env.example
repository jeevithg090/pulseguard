# Copy to `.env.local` and adjust. All variables are optional and are inlined at
# build time by Create React App, so never put secrets here — they end up in the
# public JavaScript bundle.

# Phone number used by the "Call support" and "Text support" buttons.
REACT_APP_SUPPORT_PHONE=+1-555-0100

# Emergency number shown in urgent symptom triage results and in the footer.
REACT_APP_EMERGENCY_NUMBER=112

# XYZ tile server used by the facility map, and its attribution (HTML allowed).
REACT_APP_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
REACT_APP_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
